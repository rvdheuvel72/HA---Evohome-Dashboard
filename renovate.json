{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "after 2am and before 6am every weekday"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "labels": [
    "dependencies",
    "renovate",
    "needs-review"
  ],
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep GitHub Actions Node on the tested v24 LTS line; upgrade to v26 only in a dedicated CI-verified toolchain migration.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "node"
      ],
      "allowedVersions": ">=24 <25"
    },
    {
      "description": "Keep GitHub Actions Python toolchain on the HA-verified 3.14 release line; defer 3.15 until Home Assistant wheels and tests pass.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": ">=3.14 <3.15"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "breaking-change",
        "manual-api-audit"
      ],
      "prPriority": -1
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchPackageNames": [
        "evohome-async"
      ],
      "addLabels": [
        "resideo-transport",
        "manual-api-audit"
      ],
      "description": "Keep evohome-async on HA 2026.10's tested v2 until the v3.1.0 compatibility branch and HA runtime checks pass; PR #71 tracks this migration.",
      "allowedVersions": ">=2.1.0 <3.0.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^custom_components\\/evohome_dashboard\\/manifest\\.json$/"
      ],
      "matchStrings": [
        "evohome-async==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "evohome-async",
      "datasourceTemplate": "pypi"
    }
  ],
  "automerge": false
}
